# OS junk and editor/IDE files live in the global gitignore
# (~/.gitignore_global via git config --global core.excludesfile).
# This file is only for artifacts produced by this project's stack.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# pytest writes its own .gitignore inside this dir, so it self-ignores — listed anyway so the
# rule is explicit rather than dependent on a tool's internals.
.pytest_cache/
.venv/
venv/
env/
.python-version

# Environments / secrets
.env
.env.*
*.local
secrets.*
*.pem

# dlt
.dlt/secrets.toml

# dbt
target/
dbt_packages/
logs/
.user.yml

# DuckDB local artifacts
*.duckdb
*.duckdb.wal

# Terraform — NB: .terraform.lock.hcl IS committed (pins provider versions)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# Data / lake artifacts (local)
*.parquet
data/
tmp/
# `run_fpl.py --dry-run` writes a full Bronze tree here. Real FPL payloads — not secret, but
# megabytes of source data that belong in the lake, not in git.
_local_bronze/
# The same, one layer up: where `dbt build` writes Silver Parquet when the lake bucket is unset.
_local_silver/
# And Gold. `gold_location()` falls back here on the same switch.
_local_gold/

# Node / frontend
node_modules/
dist/
build/
.cache/
